<?xml version="1.0" encoding="utf-8"?>
<!--
  Glide intentionally plays arbitrary user-entered http:// and rtsp:// streams, so
  cleartext cannot be switched off globally without removing a real feature. What was
  accidentally permitted is cleartext to Glide's own APIs, and that is what this pins.

  This does not constrain LibVLC, which uses its own native network stack. It is not
  meant to: user streams are the case that must stay permitted. Every app-owned request
  goes through Android's stack (fetch and react-native-fs), which this does constrain.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />

    <domain-config cleartextTrafficPermitted="false">
        <!-- Subtitle search and download. -->
        <domain includeSubdomains="true">subdl.com</domain>
        <!-- Metadata lookup. -->
        <domain includeSubdomains="true">omdbapi.com</domain>
        <!-- Stallion OTA control plane. Its bundle CDN sits on cloudfront.net, which is
             deliberately NOT listed: pinning all of cloudfront would also block a user
             stream hosted there, and that is the feature the base-config exists for. -->
        <domain includeSubdomains="true">stalliontech.io</domain>
        <!-- Recap and speech-to-text proxy, on its default Workers domain. A custom
             proxy domain is not listed here because AI_PROXY_URL is build-time;
             constants.ts already refuses any value that is not https://. -->
        <domain includeSubdomains="true">workers.dev</domain>
    </domain-config>
</network-security-config>
