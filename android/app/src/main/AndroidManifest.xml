<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- ExoPlayer wake mode: keeps background video playing with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- android.media.audiofx.Equalizer, attached to the player's own audio session. A
         normal permission, granted at install; it does not prompt. Replaces VLC's
         engine-specific equalizer with the system one. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- The media session service. These used to arrive by manifest merge from the VLC
         player module; deleting that module took them with it, and Media3's
         MediaNotificationManager then called startForegroundService() on a service the
         system would not let go foreground — crashing the app with
         ForegroundServiceDidNotStartInTimeException about 30s into playback. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Android 13+. Without it the session notification is never posted, so the service
         cannot go foreground even with the permissions above. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Dependencies inject the two below. Glide never requests either, but they reach
         the merged manifest and show on the store/app-info permission list. -->
    <!-- react-native-share and react-native-stallion; nothing in Glide reads phone state. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" tools:node="remove" />
    <!-- react-native-fs, declared unbounded. Scoped storage ignores it from API 29, but
         CameraRoll.deletePhotos still needs the storage group on API 26-28. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" tools:node="replace" />

    <!-- Installable on Android TV: no touchscreen there, and leanback stays optional. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
      android:name=".MainApplication"
      android:banner="@drawable/tv_banner"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:networkSecurityConfig="@xml/network_security_config"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection|colorMode|navigation|touchscreen"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true"
        android:supportsPictureInPicture="true"
        android:resizeableActivity="true"
        android:theme="@style/SplashTheme">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent-filter>
        <!-- "Open with" for audio files. Plays in the music player inside the main app,
             unlike video, which has its own player Activity. Local files only; JS checks
             the URI again (RootNavigator), since this Activity is exported. Some file
             managers label .ogg as application/ogg rather than audio/ogg. -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:scheme="content" />
            <data android:scheme="file" />
            <data android:mimeType="audio/*" />
            <data android:mimeType="application/ogg" />
        </intent-filter>
      </activity>

      <!-- Media3 owns the notification, media buttons and lock-screen controls, derived
           from the real ExoPlayer. No adapter, and no notification code in the view.
           Permissions are declared above, on the app itself. Exported, with the browser
           actions, so Android Auto and other media controllers can bind to the music
           library session. -->
      <service
        android:name="com.glide.app.player.GlidePlayerService"
        android:exported="true"
        android:foregroundServiceType="mediaPlayback">
        <intent-filter>
            <action android:name="androidx.media3.session.MediaLibraryService" />
            <action android:name="androidx.media3.session.MediaSessionService" />
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent-filter>
      </service>

      <!-- Playback resumption: a Bluetooth or headset Play with Glide not running starts
           the service, which resumes the saved queue (onPlaybackResumption). Its presence
           also lets Android 13+ show Glide's resume card in the media controls. -->
      <receiver
        android:name="androidx.media3.session.MediaButtonReceiver"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MEDIA_BUTTON" />
        </intent-filter>
      </receiver>

      <meta-data
        android:name="com.google.android.gms.car.application"
        android:resource="@xml/automotive_app_desc" />

      <activity
        android:name=".VideoPlayerActivity"
        android:label="@string/play_with_glide"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density|fontScale|locale|layoutDirection|colorMode|navigation|touchscreen"
        android:screenOrientation="fullSensor"
        android:launchMode="singleTask"
        android:exported="true"
        android:supportsPictureInPicture="true"
        android:resizeableActivity="true"
        android:theme="@style/AppTheme">
        <!-- Handle Share (ACTION_SEND) -->
        <intent-filter>
            <action android:name="android.intent.action.SEND" />
            <category android:name="android.intent.category.DEFAULT" />
            <data android:mimeType="video/*" />
        </intent-filter>
        <!-- Handle video files opened from file managers -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:mimeType="video/*" />
        </intent-filter>
        <!-- Handle video files from file:// URIs -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="file" android:mimeType="video/*" />
        </intent-filter>
        <!-- Handle video files from content:// URIs -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="content" android:mimeType="video/*" />
        </intent-filter>
        <!-- Handle HTTP video streams -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" android:mimeType="video/*" />
        </intent-filter>
        <!-- Handle HTTPS video streams -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" android:mimeType="video/*" />
        </intent-filter>
        <!-- Handle video URLs by extension (for links without MIME type) -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
            <data android:scheme="https" />
            <data android:pathPattern=".*\\.mp4" />
            <data android:pathPattern=".*\\.mkv" />
            <data android:pathPattern=".*\\.avi" />
            <data android:pathPattern=".*\\.mov" />
            <data android:pathPattern=".*\\.webm" />
            <data android:pathPattern=".*\\.m3u8" />
            <data android:pathPattern=".*\\.m4v" />
            <data android:host="*" />
        </intent-filter>
      </activity>
    </application>

</manifest>
