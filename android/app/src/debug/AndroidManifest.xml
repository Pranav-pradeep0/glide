<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Haptics Lab (debug only): the accelerometer above 200 Hz, to see the motor
         (~170 Hz). Normal permission, granted at install. -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />

    <application
        tools:targetApi="28"
        tools:ignore="GoogleAppIndexingWarning">
        <!-- Telegram step (a) spike: adb shell am start -n
             com.glide.player/com.glide.app.telegram.TelegramDebugActivity -->
        <activity
            android:name="com.glide.app.telegram.TelegramDebugActivity"
            android:exported="true"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:enableOnBackInvokedCallback="false"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            tools:targetApi="33" />
    </application>
</manifest>
