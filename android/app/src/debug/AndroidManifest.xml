<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Haptics Lab (debug only): the accelerometer above 200 Hz, to see the motor
         (~170 Hz). Normal permission, granted at install. -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />

    <application
        tools:targetApi="28"
        tools:ignore="GoogleAppIndexingWarning">

        <!--
            Phase 2 spike, debug builds only. Exported so `adb shell am start` can reach
            it; that is safe here precisely because this manifest never merges into a
            release build. Delete with HdrSpikeActivity once the question is answered.
        -->
        <activity
            android:name=".HdrSpikeActivity"
            android:exported="true"
            android:label="HDR Spike"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:screenOrientation="landscape"
            tools:ignore="DiscouragedApi" />
    </application>
</manifest>
