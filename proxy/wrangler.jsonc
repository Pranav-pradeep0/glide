{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "glide-ai-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-23",
  // Workers Logs persist by default; keep sampling low and never log request content.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.05
  },
  // GROQ_API_KEY, SUBDL_API_KEY and OMDB_API_KEY are Worker secrets
  // (`wrangler secret put <NAME>`); a route whose key is unset answers 502.
  "ratelimits": [
    {
      "name": "AI_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 6,
        "period": 60
      }
    },
    // The proxy URL ships inside the APK and is extractable, so the per-IP limit above
    // is trivially bypassed. This is the burst ceiling for everyone combined.
    {
      "name": "AI_GLOBAL_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    // Subtitle/metadata lookups and recap reports, per IP. One subtitle search can make
    // two SubDL calls plus OMDb lookups, so this is looser than the recap limit.
    {
      "name": "LOOKUP_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  // Recap reports. No id: wrangler deploy creates the namespace the first time.
  "kv_namespaces": [
    { "binding": "REPORTS" }
  ]
}
