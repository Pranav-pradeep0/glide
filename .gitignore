# Release signing keys (never commit)
# Kotlin compiler scratch output, regenerated on every build
android/.kotlin/

android/app/glide-release.keystore
android/app/my-upload-key.keystore
# Agent/session scratch
.codex-remote-attachments/

# Ad-hoc logcat dumps captured while debugging
glide-crash.txt
glide-exit-info.txt

# Vendored AARs stay out of the repo -- tracker 12.3 is removing the ones that remain.
android/app/libs/*.aar
# ...with one exception, deliberately. The Media3 FFmpeg decoder is now mandatory: with
# LibVLC gone it is the only thing that decodes AC-3, E-AC-3, DTS and TrueHD, and this
# device has none of them in hardware. Without it a release build plays those tracks
# silently with no error. It is ignored everywhere else and unresolvable from a clone, so
# CI could not build a release at all. Committed until the GitHub Packages coordinate from
# glide-ffmpeg-decoder exists (plan section 4.3), which is the real fix.
!android/app/libs/lib-decoder-ffmpeg-release.aar

# Stallion bundle-signing private key (npx stallion generate-key-pair writes it here)
stallion/secret-keys/

# generated haptics test clips (node scripts/haptics-fixtures.js)
.haptics-fixtures/
