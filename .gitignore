# Release signing keys (never commit)
# Kotlin compiler scratch output, regenerated on every build
android/.kotlin/

android/app/glide-release.keystore
android/app/my-upload-key.keystore
# Agent/session scratch
.codex-remote-attachments/

# Ad-hoc logcat dumps captured while debugging
glide-crash.txt
glide-exit-info.txt

# Vendored AARs stay out of the repo -- tracker 12.3 is removing the ones that remain.
android/app/libs/*.aar
# ...except these, deliberately. The Media3 FFmpeg decoder is mandatory: with LibVLC gone
# it is the only thing that decodes AC-3, E-AC-3, DTS, TrueHD, MP2 and ALAC, and this
# device has none of the first four in hardware. Without it a release build plays those
# tracks silently with no error. Both decoder AARs come from glide-ffmpeg-decoder's CI with
# a .sha256 and a .properties (BUILD_INFO) that Glide's CI checks.
!android/app/libs/lib-decoder-ffmpeg-release.aar
# dav1d AV1 decoder, same repo and checks: AV1 on phones without an AV1 decoder.
!android/app/libs/lib-decoder-av1-release.aar
# TDLib for Telegram (docs/telegram.md), from the private glide-tdlib CI: same reason.
!android/app/libs/glide-tdlib-release.aar

# Stallion bundle-signing private key (npx stallion generate-key-pair writes it here)
stallion/secret-keys/

# generated haptics test clips (node scripts/haptics-fixtures.js)
.haptics-fixtures/
.credits-fixtures/
